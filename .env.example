# Repo GitHub Pages qui héberge le résultat de la génération HTML.
# Utilisé en SSH (clé de déploiement) par défaut.
GIT_REPO_URL=git@github.com:mylittlecanasson/mylittlecanasson.github.io.git

# Répertoire des données runtime (dans le conteneur et en local).
CANASSON_DATA_DIR=./data

# Répertoire contenant la clé SSH de déploiement (monté en /root/.ssh:ro).
SSH_DIR=~/.ssh
